@code {
    private bool isCollapsed = false;

    private string SidebarClass => isCollapsed ? "sidebar collapsed" : "sidebar expanded";

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
    }
}

<div class="@SidebarClass">
    <button class="toggle-button" @onclick="ToggleSidebar">
        ☰
    </button>

    <nav>
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">🏠 Home</NavLink>
        <NavLink class="nav-item" href="/timer">⏳ Timer</NavLink>
        <NavLink class="nav-item" href="/fetchdata">📊 Fetch Data</NavLink>
    </nav>
</div>

<style>
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 200px;
        height: 100vh;
        background: linear-gradient(180deg, #ffcc00, #ff9900);
        
        color: white;
        transition: width 0.3s ease-in-out;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 4px 0px 10px rgba(0, 0, 0, 0.2);
    }

    .collapsed {
        width: 60px;
    }

    .expanded {
        width: 200px;
    }

    .toggle-button {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        font-size: 24px;
        padding: 10px;
        cursor: pointer;
        text-align: left;
        transition: background 0.3s ease-in-out;
    }

    .toggle-button:hover {
        background: rgba(255, 255, 255, 0.4);
    }

    .nav-item {
        display: block;
        padding: 12px 16px;
        text-decoration: none;
        color: white;
        font-size: 16px;
        transition: background 0.2s, transform 0.2s;
        border-radius: 4px;
        margin: 4px 8px;
    }

    .nav-item:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateX(5px);
    }

    .nav-item.active {
        background: rgba(255, 255, 255, 0.5);
    }

</style>
